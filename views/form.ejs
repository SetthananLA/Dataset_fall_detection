<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Input Form</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@100..900&display=swap" rel="stylesheet">
</head>

<style>
  * {
    font-family: "Noto Sans Thai", sans-serif;
  }

  body {

    background-color: #1E292F;
    margin: 0;
    padding: 0;

  }

  .container {
    width: 50%;
    margin: 0 auto;
    padding: 20px;
    background-color: #fff;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    margin-top: 50px;
    margin-bottom: 50px;
  }

  h1 {
    color: #333;
  }

  form {
    display: flex;
    flex-direction: column;
  }

  label {
    font-size: 18px;
    margin-bottom: 5px;
    color: #333;
  }

  input {
    margin-bottom: 15px;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  input[type="number"] {
    width: 10%;
    font-size: 15px;
  }

  button {
    font-size: 24px;
    padding: 10px 20px;
    border: none;
    background-color: #5cb85c;
    color: white;
    cursor: pointer;
    border-radius: 4px;
  }

  button:hover {
    background-color: #4cae4c;
  }

  textarea {
    resize: vertical;
    /* Allow vertical resizing only */
    max-width: 100%;
  }
</style>

<body>
  <div class="container">
    <h1>กรอกข้อมูลผู้ใช้</h1>
    <form action="/submit" method="POST">
      <label for="elder-name">ชื่อผู้สูงอายุ:</label>
      <input type="text" id="elder-name" name="elder_name" required><br>

      <label for="elder-ages">ระบุอายุของผู้สูงอายุ</label>
      <input type="number" id="elder-ages" name="elder_ages" min="1" max="100" required><br>

      <label>ที่อยู่ผู้สูงอายุ</label>
      <textarea id="textarea" name="elder_address" placeholder="Enter text.." rows="4" cols="50"></textarea><br>

      <label for="caregiver-name">ชื่อผู้ดูแล:</label>
      <input type="text" id="caregiver-name" name="caregiver_name" required><br>

      <label for="caregiver-userid">UserID ผู้ดูแล:</label>
      <input type="text" id="caregiver-userid" name="caregiver_userid" required><br>

      <label for="relative-name">ชื่อญาติ:</label>
      <input type="text" id="relative-name" name="relative_name" required><br>

      <label for="relative-userid">UserID ญาติ:</label>
      <input type="text" id="relative-userid" name="relative_userid" required><br>

      <label for="doctor-name">ชื่อศูนย์ช่วยเหลือ:</label>
      <input type="text" id="doctor-name" name="doctor_name" required><br>

      <label for="doctor-userid">UserID ศูนย์ช่วยเหลือ:</label>
      <input type="text" id="doctor-userid" name="doctor_userid" required><br>

      <button type="submit">ยืนยัน</button>
    </form>
  </div>

</body>

</html>