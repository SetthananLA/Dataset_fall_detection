<!DOCTYPE html>
<html>

<head>
    <title>Fall Detection</title>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs"></script>
    <link rel="stylesheet" href="stylesheet/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@100..900&display=swap" rel="stylesheet">
</head>

<style>
    .container {
        position: relative;
    }

    .elder-profile {
        display: none;
        position: absolute;
        background-color: white;
        color: black;
        border-radius: 15px;
        padding: 10px;
    }

    #olderName:hover .elder-profile {
        display: block;
    }
</style>


<body>
    <div class="container">
        <div style="width: 100vw;">
            <button class="btn" onclick="window.location.href='/history';">ประวัติการล้ม</button>

        </div>
        <h1>หน้าหลัก</h1>
        <div class="display-status">
            <div class="grid-item">
                <h3 id="olderName">ชื่อผู้สูงอายุ: <%= olderName%>
                        <div class="elder-profile">
                            <ul>
                                <li>ชื่อ: <%= olderName%>
                                </li>
                                <li>ที่อยู่: <%= olderAddress%>
                                </li>
                                <li>อายุ: <%= olderAges%>></li>
                            </ul>
                        </div>
                </h3>

            </div>
            <div class="grid-item">
                <h3 id="careName">ชื่อผู้ดูแล: <%= careName%>
                </h3>
            </div>
            <div class="grid-item">
                <h3 id="timedisplay">วันที่: xxx เวลา xxx</h3>
            </div>
            <div class="grid-item">
                <h3 style="margin-right: 10px;">สถานะ: </h3>
                <span id="pose" style="color:red; font-size: 24px;">ล้มหลัง</span>
            </div>
        </div>
        <div class="canvas-warpper">
            <video id="videoFile" width="500px" height="500px" style="display: block ;"></video>
            <canvas id="canvas" width="500px" height="500px" style="display: block;"></canvas>
        </div>
    </div>


    <script type="module">

        import { PoseLandmarker, FilesetResolver, DrawingUtils } from "https://cdn.skypack.dev/@mediapipe/tasks-vision@0.10.0";

        var poseLandmarker = null;
        const createPoseLandmarker = async () => {
            const vision = await FilesetResolver.forVisionTasks("https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.0/wasm");
            poseLandmarker = await PoseLandmarker.createFromOptions(vision, {
                baseOptions: {
                    modelAssetPath: `https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task`,
                    delegate: "GPU"
                },
                // runningMode: "IMAGE",
                runningMode: "VIDEO",
                numPoses: 1
            });
        };
        await createPoseLandmarker();
        openWebcam();

        const video = document.getElementById('videoFile');
        const canvas = document.getElementById('canvas');
        const pose = document.getElementById('pose');
        const canvasCtx = canvas.getContext("2d");
        const drawingUtils = new DrawingUtils(canvasCtx);
        const timedisplay = document.getElementById('timedisplay');
        let data;

        // โหลดโมเดล
        // const modelUrl = '/tfjscnn_model/model.json'; // เปลี่ยนเป็น URL ของโมเดลคุณ
        const modelUrl = '/model.json'; // เปลี่ยนเป็น URL ของโมเดลคุณ
        const model = await tf.loadLayersModel(modelUrl);

        let hasRunPredict2 = false; // สถานะเพื่อบอกว่า predict2(data) ทำงานไปแล้วหรือไม่
        let idRequestframe = null;
        async function openWebcam() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: true });
                video.srcObject = stream;
                //video.src = './videofall/fall_left1724659132627.webm';

                // สร้าง object รูปภาพ
                // var img = new Image();
                // img.src = 'falltest.png'; // แทนที่ด้วย URL รูปภาพที่ต้องการ

                // เมื่อรูปภาพโหลดเสร็จ ให้ทำการวาดลงบน canvas
                // img.onload = async function () {
                //     canvasCtx.drawImage(img, 0, 0, 500, 500); // วาดรูปภาพที่ตำแหน่ง (0, 0) และขนาด 500x500 พิกเซล
                //     await preprocessVideo(canvas);
                //     tf.tidy(() => {
                //         const tensor = tf.browser.fromPixels(canvas)
                //             .resizeNearestNeighbor([150, 150]) // Resize image to target size
                //             .toFloat()
                //             .div(tf.scalar(255.0)); // Normalize pixel values to [0, 1]

                //         predict(tensor, data);
                //     });

                // };

                video.play();
                video.addEventListener('play', function () {
                    async function drawFrame() {
                        await preprocessVideo(video);

                        /*tf.tidy(() => {
                            const tensor = tf.browser.fromPixels(canvas)
                                .resizeNearestNeighbor([150, 150]) // Resize image to target size
                                .toFloat()
                                .div(tf.scalar(255.0)); // Normalize pixel values to [0, 1]

                            predict(tensor).then(async (result) => {
                                console.log(result)
                                // ตรวจสอบการเปลี่ยนแปลงของ acc
                                if (result < 0.1) { // ใช้การตรวจสอบเนื้อหาของอาร์เรย์
                                    await predict2(data); // เรียก predict2 ถ้าค่าเปลี่ยนไป
                                    // window.location.href='/noctification'
                                    // video.pause();
                                    window.cancelAnimationFrame(idRequestframe);
                                }

                            });

                        });*/

                        idRequestframe = requestAnimationFrame(drawFrame);
                    }
                    drawFrame();
                });

            } catch (error) {
                console.log(error);
            }

        }

        function getDateTime() {
            let date = new Date();
            let formattedDate = date.toLocaleDateString('th-TH'); // กำหนด locale ตามที่ต้องการ
            let formattedTime = date.toLocaleTimeString('th-TH', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false // ใช้รูปแบบเวลา 24 ชั่วโมง
            });
            return [formattedDate, formattedTime];
        }

        function displayTime(display) {
            const [formattedDate, formattedTime] = getDateTime();
            display.innerText = `วันที่: ${formattedDate} เวลา: ${formattedTime}`;
        }

        async function preprocessVideo(video) {
            displayTime(timedisplay);
            let startTimeMs = performance.now();
            const result = await poseLandmarker.detectForVideo(video, startTimeMs);
            // const result = await poseLandmarker.detect(video);
            canvasCtx.clearRect(0, 0, canvas.width, canvas.height);
            canvasCtx.fillStyle = 'black';
            canvasCtx.fillRect(0, 0, canvas.width, canvas.height);

            for (const landmark of result.landmarks) {
                const nose = [landmark[0].x * canvas.width, landmark[0].y * canvas.height, landmark[0].z * canvas.width];
                const left_hip = [landmark[23].x * canvas.width, landmark[23].y * canvas.height, landmark[23].z * canvas.width];
                const right_hip = [landmark[24].x * canvas.width, landmark[24].y * canvas.height, landmark[24].z * canvas.width];

                const center_hip = [
                    (left_hip[0] + right_hip[0]) / 2,
                    (left_hip[1] + right_hip[1]) / 2,
                    (left_hip[2] + right_hip[2]) / 2
                ];

                const dx = center_hip[0] - nose[0];
                const dy = center_hip[1] - nose[1];
                const dz = center_hip[2] - nose[2];

                const xRadians = Math.atan2(dx, dy);
                const xDegrees = xRadians * (180 / Math.PI);

                const zRadians = Math.atan2(dy, dz);
                const zDegrees = zRadians * (180 / Math.PI);
                // console.log(xDegrees, zDegrees)
                if (xDegrees >= -45 && xDegrees <= 45) { //แยกซ้ายขวา
                    data = [[xDegrees.toFixed(2), 0]];
                    // console.log(data[0])
                }
                else {
                    data = [[0, zDegrees.toFixed(2)]]; //แยกหน้าหลัง
                    // console.log(data[0])
                }
                // console.log(data[0])
                drawingUtils.drawLandmarks(landmark, {
                    radius: (data) => DrawingUtils.lerp(data.from.z, -0.15, 0.1, 5, 1),
                    color: 'red',
                    lineWidth: 2
                });
                drawingUtils.drawConnectors(landmark, PoseLandmarker.POSE_CONNECTIONS, {
                    color: 'green',
                    lineWidth: 3,
                });
            }
        }

        let count = 0;
        let isFall = false;
        let previousState = isFall;

        function checkVariableChange(currentState) {
            if (currentState === previousState) {
                return;
            }

            if (currentState) {
                const [date, time] = getDateTime();
                if (count > 0) {
                    //notification(`Fall_${count}_[${date}-${time}]`);

                    count++;
                }

            }
            else if (count === 0) {
                count++;
            }

            previousState = currentState;
        }


        async function predict(tensor) {
            const predictions = model.predict(tensor.expandDims(0)); // เพิ่ม dimension batch
            const array = await predictions.array();
            let result = parseFloat(array[0][0]).toFixed(2);
            // console.log(`CNN ${result}`)
            if (result < 0.7) {

                isFall = true;//ลบออกตอนใช้medel2

            } else {
                pose.style = 'color: green; font-size: 30px';
                pose.innerText = 'ไม่ล้ม';
                isFall = false;
            }

            checkVariableChange(isFall);//ถ้าสถานะมีการเปลี่ยนค่อยแจ้งเตือน
            predictions.dispose();
            return result;
        }

        function predict2(data) {
            if (data) {
                // console.log(`data ${data}`)
                fetch('/predict', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                })
                    .then(response => response.json())
                    .then(data => {
                        const label = data[0];
                        console.log("RF" + label);

                        if (label === 0) {
                            pose.style = 'color: red; font-size: 30px';
                            pose.innerText = 'ล้มหน้า';
                            isFall = true;
                            getImage(video);
                        }
                        if (label === 1) {
                            pose.style = 'color: red; font-size: 30px';
                            pose.innerText = 'ล้มหลัง';
                            isFall = true;
                            getImage(video);
                        }
                        if (label === 2) {
                            pose.style = 'color: red; font-size: 30px';
                            pose.innerText = 'ล้มซ้าย';
                            isFall = true;
                            getImage(video);
                        }
                        if (label === 3) {
                            pose.style = 'color: red; font-size: 30px';
                            pose.innerText = 'ล้มขวา';
                            isFall = true;
                            getImage(video);
                        }
                    })
                    .catch(error => console.error('Error:', error));

            }
        }


        function notification(msg) {
            console.log(`${msg}`);
            // predict2(data);
        }


        function getImage(video) {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = 500;
            canvas.height = 500;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            canvas.toBlob(async (blob) => {
                // สร้าง FormData เพื่อจัดส่งข้อมูล
                const formData = new FormData();
                formData.append('file', blob, 'snapshot.png'); // 'file' คือชื่อ field ที่จะส่ง, 'snapshot.png' คือชื่อไฟล์
                // เพิ่มข้อมูล 'pose' ลงใน formData
                formData.append('pose', pose.innerText);
                try {
                    // ส่งข้อมูลไปยังเซิร์ฟเวอร์
                    const response = await fetch('/upload', {
                        method: 'POST',
                        body: formData,
                    });

                    if (response.ok) {
                        console.log('Upload successful!');
                    } else {
                        console.error('Upload failed.');
                    }
                } catch (error) {
                    console.error('Error uploading:', error);
                }
            });
        }



    </script>

</body>

</html>